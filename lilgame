<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mood Relief Arcade - Earth Tone</title>
    <!-- Memuat Google Fonts Plus Jakarta Sans untuk tipografi yang bersih dan nyaman -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Variabel Warna Tema Earth Tone */
        :root {
            --bg-cream: #F5F0E6;
            --card-bg: #FAF7F2;
            --sage: #8A9A86;
            --sage-dark: #6E7E6A;
            --sage-light: #D8E2DC;
            --terracotta: #C87D55;
            --terracotta-dark: #A8633E;
            --olive: #7F8C72;
            --espresso: #3A322C;
            --muted-text: #6B5B52;
            --sand: #E6CCB2;
            --hole-dark: #4A3B32;
        }

        /* Reset CSS dasar dan pencegahan seleksi teks saat bermain */
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-cream);
            color: var(--espresso);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
        }

        /* Pengaturan Layar / Halaman */
        .screen {
            display: none;
            width: 100%;
            max-width: 480px;
            min-height: 100vh;
            padding: 20px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            animation: fadeIn 0.25s ease-out;
        }

        .screen.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Navigasi Atas & Skor */
        .top-bar {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .btn-back {
            background-color: var(--sand);
            color: var(--espresso);
            border: none;
            padding: 10px 18px;
            border-radius: 14px;
            font-weight: 700;
            cursor: pointer;
            font-size: 0.9rem;
            transition: transform 0.1s, background-color 0.2s;
            box-shadow: 0 2px 6px rgba(58, 50, 44, 0.08);
        }

        .btn-back:hover {
            background-color: #dec0a1;
        }

        .btn-back:active {
            transform: scale(0.95);
        }

        .score-badge {
            background-color: var(--card-bg);
            padding: 10px 18px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 0.95rem;
            border: 1.5px solid var(--sand);
            box-shadow: 0 2px 6px rgba(58, 50, 44, 0.05);
        }

        /* ================= MENU UTAMA ================= */
        .menu-card {
            background-color: var(--card-bg);
            padding: 30px 24px;
            border-radius: 28px;
            box-shadow: 0 12px 32px rgba(58, 50, 44, 0.07);
            border: 1px solid rgba(230, 204, 178, 0.6);
            width: 100%;
            text-align: center;
        }

        .menu-badge {
            display: inline-block;
            background-color: var(--sage-light);
            color: var(--sage-dark);
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        h1 {
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }

        .subtitle {
            font-size: 0.9rem;
            color: var(--muted-text);
            margin-bottom: 24px;
            line-height: 1.5;
        }

        .game-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .game-btn {
            background-color: var(--sage);
            color: white;
            border: none;
            padding: 16px 18px;
            border-radius: 20px;
            text-align: left;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: transform 0.15s, filter 0.2s;
            box-shadow: 0 6px 16px rgba(138, 154, 134, 0.28);
        }

        .game-btn:nth-child(2) {
            background-color: var(--terracotta);
            box-shadow: 0 6px 16px rgba(200, 125, 85, 0.28);
        }

        .game-btn:nth-child(3) {
            background-color: var(--olive);
            box-shadow: 0 6px 16px rgba(127, 140, 114, 0.28);
        }

        .game-btn:hover {
            filter: brightness(1.04);
            transform: translateY(-2px);
        }

        .game-btn:active {
            transform: scale(0.97) translateY(0);
        }

        .game-icon {
            font-size: 2rem;
            background: rgba(255, 255, 255, 0.22);
            width: 54px;
            height: 54px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
        }

        .game-info h3 {
            font-size: 1.05rem;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .game-info p {
            font-size: 0.8rem;
            opacity: 0.92;
            line-height: 1.35;
        }

        /* ================= GAME 1: VIRTUAL BUBBLE WRAP ================= */
        #bubble-screen {
            justify-content: center;
        }

        .bubble-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            width: 100%;
            background-color: var(--card-bg);
            padding: 18px;
            border-radius: 24px;
            border: 1.5px solid var(--sand);
            box-shadow: inset 0 2px 8px rgba(58, 50, 44, 0.05), 0 8px 20px rgba(58, 50, 44, 0.04);
            margin-bottom: 18px;
        }

        .bubble {
            aspect-ratio: 1;
            border-radius: 50%;
            background: radial-gradient(circle at 32% 32%, #B5C4B1, var(--sage));
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(58, 50, 44, 0.18), inset 0 -2px 4px rgba(0,0,0,0.12);
            transition: transform 0.08s ease, background 0.15s ease;
        }

        .bubble:active:not(.popped) {
            transform: scale(0.85);
        }

        .bubble.popped {
            background: var(--sage-light);
            box-shadow: inset 0 2px 5px rgba(58, 50, 44, 0.12);
            transform: scale(0.92);
            cursor: default;
        }

        .action-btn {
            background-color: var(--terracotta);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 16px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            box-shadow: 0 6px 14px rgba(200, 125, 85, 0.25);
            transition: transform 0.1s, background-color 0.2s;
        }

        .action-btn:hover {
            background-color: var(--terracotta-dark);
        }

        .action-btn:active {
            transform: scale(0.96);
        }

        /* ================= GAME 2: HIT THE BEAR ================= */
        .arcade-machine {
            background-color: var(--sand);
            padding: 22px;
            border-radius: 28px;
            width: 100%;
            border: 4px solid var(--terracotta);
            box-shadow: 0 12px 28px rgba(58, 50, 44, 0.12);
        }

        .arcade-header {
            background-color: var(--terracotta);
            color: white;
            text-align: center;
            padding: 12px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 1rem;
            margin-bottom: 20px;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(168, 99, 62, 0.3);
        }

        .holes-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .hole {
            aspect-ratio: 1;
            background-color: var(--hole-dark);
            border-radius: 50%;
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 10px 14px rgba(0,0,0,0.45), 0 2px 0 rgba(255,255,255,0.4);
            cursor: pointer;
        }

        .bear {
            position: absolute;
            bottom: -100%;
            left: 50%;
            transform: translateX(-50%);
            font-size: 3.1rem;
            line-height: 1;
            transition: bottom 0.16s cubic-bezier(0.175, 0.885, 0.32, 1.275), transform 0.2s ease;
            pointer-events: none;
        }

        .hole.up .bear {
            bottom: 10%;
        }

        .hole.bonked .bear {
            transform: translateX(-50%) scale(0.8) rotate(15deg);
            filter: brightness(1.3);
        }

        .speed-indicator {
            margin-top: 18px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--espresso);
            background-color: rgba(250, 247, 242, 0.7);
            padding: 8px 14px;
            border-radius: 12px;
            font-weight: 700;
        }

        /* ================= GAME 3: CUT THE BANANA ================= */
        #banana-screen {
            padding: 18px;
        }

        .canvas-wrapper {
            position: relative;
            width: 100%;
            height: 66vh;
            min-height: 380px;
        }

        #banana-canvas {
            background-color: var(--card-bg);
            border-radius: 24px;
            width: 100%;
            height: 100%;
            display: block;
            touch-action: none;
            box-shadow: 0 10px 24px rgba(58, 50, 44, 0.07);
            border: 2px solid var(--sand);
            cursor: crosshair;
        }

        .canvas-hint {
            position: absolute;
            bottom: 14px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 0.78rem;
            color: var(--muted-text);
            background: rgba(245, 240, 230, 0.85);
            padding: 4px 12px;
            border-radius: 12px;
            pointer-events: none;
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <!-- ================= MENU UTAMA ================= -->
    <div id="menu-screen" class="screen active">
        <div class="menu-card">
            <span class="menu-badge">RUANG SANTAI & RELAKSASI</span>
            <h1>Mood Relief Arcade 🌿</h1>
            <p class="subtitle">Pilih mini-game santai buat lepasin penat, jenuh, atau rasa keselmu sejenak.</p>
            
            <div class="game-list">
                <button class="game-btn" onclick="openGame('bubble')">
                    <div class="game-icon">🫧</div>
                    <div class="game-info">
                        <h3>Virtual Bubble Wrap</h3>
                        <p>Pencet gelembungnya sampai puas dengan efek suara pop!</p>
                    </div>
                </button>

                <button class="game-btn" onclick="openGame('bear')">
                    <div class="game-icon">🧸</div>
                    <div class="game-info">
                        <h3>Hit the Bear</h3>
                        <p>Ketuk beruang yang muncul, makin tinggi skor makin cepat.</p>
                    </div>
                </button>

                <button class="game-btn" onclick="openGame('banana')">
                    <div class="game-icon">🍌</div>
                    <div class="game-info">
                        <h3>Cut the Banana</h3>
                        <p>Usap atau ketuk pisang yang melayang untuk membelahnya.</p>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- ================= GAME 1: BUBBLE WRAP ================= -->
    <div id="bubble-screen" class="screen">
        <div class="top-bar">
            <button class="btn-back" onclick="goHome()">← Menu</button>
            <div class="score-badge">Pecah: <span id="bubble-count">0</span></div>
        </div>
        <div class="bubble-grid" id="bubble-grid"></div>
        <button class="action-btn" onclick="initBubbles()">Ganti Lembaran Baru ✨</button>
    </div>

    <!-- ================= GAME 2: HIT THE BEAR ================= -->
    <div id="bear-screen" class="screen">
        <div class="top-bar">
            <button class="btn-back" onclick="goHome()">← Menu</button>
            <div class="score-badge">Skor: <span id="bear-score">0</span></div>
        </div>
        <div class="arcade-machine">
            <div class="arcade-header">BEAR SMASH ZONE</div>
            <div class="holes-grid" id="holes-grid">
                <div class="hole" data-index="0"><div class="bear">🐻</div></div>
                <div class="hole" data-index="1"><div class="bear">🐻</div></div>
                <div class="hole" data-index="2"><div class="bear">🐻</div></div>
                <div class="hole" data-index="3"><div class="bear">🐻</div></div>
                <div class="hole" data-index="4"><div class="bear">🐻</div></div>
                <div class="hole" data-index="5"><div class="bear">🐻</div></div>
            </div>
            <div class="speed-indicator" id="bear-speed-text">Kecepatan: Level 1</div>
        </div>
    </div>

    <!-- ================= GAME 3: CUT THE BANANA ================= -->
    <div id="banana-screen" class="screen">
        <div class="top-bar">
            <button class="btn-back" onclick="goHome()">← Menu</button>
            <div class="score-badge">Terpotong: <span id="banana-score">0</span></div>
        </div>
        <div class="canvas-wrapper">
            <canvas id="banana-canvas"></canvas>
            <div class="canvas-hint">Geser jari atau kursor untuk menebas pisang</div>
        </div>
    </div>

    <script>
        /* ================= WEB AUDIO API (EFEK SUARA SINTETIS) ================= */
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx;

        function ensureAudio() {
            if (!audioCtx) audioCtx = new AudioContext();
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        // Suara Bubble Wrap Pop
        function playPopSound() {
            try {
                ensureAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sine';
                const now = audioCtx.currentTime;
                osc.frequency.setValueAtTime(340 + Math.random() * 140, now);
                osc.frequency.exponentialRampToValueAtTime(920, now + 0.03);
                osc.frequency.exponentialRampToValueAtTime(130, now + 0.08);

                gain.gain.setValueAtTime(0.5, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.08);
            } catch (e) {}
        }

        // Suara Pukul Beruang (Bonk)
        function playBonkSound() {
            try {
                ensureAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                const now = audioCtx.currentTime;
                osc.frequency.setValueAtTime(220, now);
                osc.frequency.exponentialRampToValueAtTime(65, now + 0.15);

                gain.gain.setValueAtTime(0.6, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.15);
            } catch (e) {}
        }

        // Suara Tebasan Pisang (Slice)
        function playSliceSound() {
            try {
                ensureAudio();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                const now = audioCtx.currentTime;
                osc.frequency.setValueAtTime(850, now);
                osc.frequency.exponentialRampToValueAtTime(180, now + 0.12);

                gain.gain.setValueAtTime(0.25, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);

                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(now);
                osc.stop(now + 0.12);
            } catch (e) {}
        }

        /* ================= NAVIGASI HALAMAN ================= */
        function openGame(gameName) {
            ensureAudio();
            stopBearGame();
            stopBananaGame();

            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(`${gameName}-screen`).classList.add('active');

            if (gameName === 'bubble') initBubbles();
            if (gameName === 'bear') startBearGame();
            if (gameName === 'banana') {
                // Sedikit jeda agar layout layar aktif sebelum mengukur ukuran canvas
                requestAnimationFrame(() => startBananaGame());
            }
        }

        function goHome() {
            stopBearGame();
            stopBananaGame();
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('menu-screen').classList.add('active');
        }

        /* ================= GAME 1: VIRTUAL BUBBLE WRAP ================= */
        let poppedTotal = 0;
        function initBubbles() {
            const grid = document.getElementById('bubble-grid');
            grid.innerHTML = '';
            // Grid 6 kolom x 8 baris = 48 gelembung
            for (let i = 0; i < 48; i++) {
                const btn = document.createElement('button');
                btn.className = 'bubble';
                btn.setAttribute('aria-label', 'Gelembung');
                btn.addEventListener('pointerdown', (e) => {
                    e.preventDefault();
                    if (!btn.classList.contains('popped')) {
                        btn.classList.add('popped');
                        playPopSound();
                        poppedTotal++;
                        document.getElementById('bubble-count').innerText = poppedTotal;
                    }
                });
                grid.appendChild(btn);
            }
        }

        /* ================= GAME 2: HIT THE BEAR ================= */
        let bearScore = 0;
        let bearTimer = null;
        let isBearRunning = false;
        let lastHole = -1;

        const holes = document.querySelectorAll('.hole');
        holes.forEach(hole => {
            hole.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                if (hole.classList.contains('up') && !hole.classList.contains('bonked')) {
                    hole.classList.add('bonked');
                    hole.classList.remove('up');
                    playBonkSound();
                    bearScore++;
                    document.getElementById('bear-score').innerText = bearScore;
                    updateSpeedLabel();
                }
            });
        });

        function updateSpeedLabel() {
            const level = Math.floor(bearScore / 5) + 1;
            document.getElementById('bear-speed-text').innerText = `Kecepatan: Level ${level}`;
        }

        function startBearGame() {
            bearScore = 0;
            document.getElementById('bear-score').innerText = 0;
            updateSpeedLabel();
            isBearRunning = true;
            peepBear();
        }

        function stopBearGame() {
            isBearRunning = false;
            clearTimeout(bearTimer);
            holes.forEach(h => h.classList.remove('up', 'bonked'));
        }

        function peepBear() {
            if (!isBearRunning) return;

            const speedReduction = Math.min(bearScore * 22, 750);
            const showTime = Math.max(1100 - speedReduction, 320);

            let idx;
            do {
                idx = Math.floor(Math.random() * holes.length);
            } while (idx === lastHole);
            lastHole = idx;

            const hole = holes[idx];
            hole.classList.remove('bonked');
            hole.classList.add('up');

            bearTimer = setTimeout(() => {
                hole.classList.remove('up');
                if (isBearRunning) peepBear();
            }, showTime);
        }

        /* ================= GAME 3: CUT THE BANANA ================= */
        const canvas = document.getElementById('banana-canvas');
        const ctx = canvas.getContext('2d');
        let bananaAnimId = null;
        let bananaSpawnTimer = null;
        let bananas = [];
        let slicedHalves = [];
        let bladeTrail = [];
        let bananaScore = 0;
        let isSlicing = false;

        function resizeCanvas() {
            if (!canvas) return;
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
        }

        window.addEventListener('resize', () => {
            if (document.getElementById('banana-screen').classList.contains('active')) {
                resizeCanvas();
            }
        });

        function startBananaGame() {
            resizeCanvas();
            bananaScore = 0;
            bananas = [];
            slicedHalves = [];
            bladeTrail = [];
            document.getElementById('banana-score').innerText = 0;

            spawnBananaWave();
            bananaSpawnTimer = setInterval(spawnBananaWave, 1450);
            updateBananaCanvas();
        }

        function stopBananaGame() {
            cancelAnimationFrame(bananaAnimId);
            clearInterval(bananaSpawnTimer);
        }

        function spawnBananaWave() {
            if (canvas.width === 0) resizeCanvas();
            const count = Math.floor(Math.random() * 2) + 1;
            for (let i = 0; i < count; i++) {
                bananas.push({
                    x: Math.random() * (canvas.width - 90) + 45,
                    y: canvas.height + 35,
                    vx: (Math.random() - 0.5) * 3.2,
                    vy: -(Math.random() * 3.5 + (canvas.height * 0.019)),
                    rotation: Math.random() * Math.PI * 2,
                    vRot: (Math.random() - 0.5) * 0.1,
                    radius: 34
                });
            }
        }

        function checkSlice(x, y) {
            for (let i = bananas.length - 1; i >= 0; i--) {
                const b = bananas[i];
                const dist = Math.hypot(x - b.x, y - b.y);
                if (dist < b.radius + 16) {
                    playSliceSound();
                    bananaScore++;
                    document.getElementById('banana-score').innerText = bananaScore;

                    // Belahan pisang terpisah ke kiri dan kanan
                    slicedHalves.push(
                        { x: b.x - 12, y: b.y, vx: b.vx - 2.6, vy: b.vy * 0.5, rot: b.rotation - 0.2, alpha: 1 },
                        { x: b.x + 12, y: b.y, vx: b.vx + 2.6, vy: b.vy * 0.5, rot: b.rotation + 0.4, alpha: 1 }
                    );
                    bananas.splice(i, 1);
                }
            }
        }

        function getPointerPos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        canvas.addEventListener('pointerdown', (e) => {
            isSlicing = true;
            const pos = getPointerPos(e);
            bladeTrail.push({ x: pos.x, y: pos.y, life: 10 });
            checkSlice(pos.x, pos.y);
        });

        canvas.addEventListener('pointermove', (e) => {
            if (!isSlicing) return;
            const pos = getPointerPos(e);
            bladeTrail.push({ x: pos.x, y: pos.y, life: 10 });
            checkSlice(pos.x, pos.y);
        });

        window.addEventListener('pointerup', () => {
            isSlicing = false;
        });

        function updateBananaCanvas() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Gambar & perbarui pisang utuh
            for (let i = bananas.length - 1; i >= 0; i--) {
                const b = bananas[i];
                b.x += b.vx;
                b.y += b.vy;
                b.vy += 0.26; // Gravitasi
                b.rotation += b.vRot;

                ctx.save();
                ctx.translate(b.x, b.y);
                ctx.rotate(b.rotation);
                ctx.font = '52px serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('🍌', 0, 0);
                ctx.restore();

                if (b.y > canvas.height + 70) {
                    bananas.splice(i, 1);
                }
            }

            // Gambar & perbarui potongan pisang yang terbelah
